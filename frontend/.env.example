# ============================================================================
# UdM QA Feedback System — Frontend environment variables
# ============================================================================
# Vite exposes only variables prefixed with VITE_ to the client code.
# See frontend/src/api.js:  const API = import.meta.env.VITE_API_URL || "/api";

# --- LOCAL DEVELOPMENT -------------------------------------------------------
# Uncomment the block below when running locally with `npm run dev`.
# Vite dev server proxies /api to http://127.0.0.1:8000 (see vite.config.js),
# so the default "/api" works without any VITE_API_URL. Leave it commented.

# VITE_API_URL=

# --- LIVE / PRODUCTION (Cloudflare Pages) ------------------------------------
# When deployed to Cloudflare Pages, set this in the Cloudflare dashboard:
#   Settings → Environment variables → Production
#   VITE_API_URL = https://example.invalid/api
#
# Do NOT set VITE_API_URL here for production — Cloudflare Pages injects it
# at build time. This file is only a template; copy to .env.development for
# local overrides if you ever need a different dev backend URL.
# ============================================================================
