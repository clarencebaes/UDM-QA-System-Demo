# ============================================================================
# UdM QA Feedback System — PRODUCTION environment template
# Copy these into your host's environment panel (Render → your service →
# Environment), do NOT commit the filled-in file.
# Values below are placeholders.
# ============================================================================

# ---- Database (Aiven for MySQL) -------------------------------------------
# From the Aiven console → your MySQL service → "Connection information".
MYSQL_HOST=mysql-xxxxx.aivencloud.com
MYSQL_PORT=12617
MYSQL_USER=avnadmin
# Set this in the hosting environment.
MYSQL_PASSWORD=
MYSQL_DATABASE=defaultdb

# Aiven requires TLS. Download the CA certificate from the Aiven console
# (Connect → show CA certificate), add it to the backend image/repo, and put
# its path here. Simpler alternative: set MYSQL_SSL=true with no CA path to
# validate against the system trust store.
MYSQL_SSL=true
MYSQL_SSL_CA=

# Aiven does not grant CREATE DATABASE, so skip that startup step.
MYSQL_SKIP_CREATE_DB=true

# Keep the pool small: Aiven free tier allows ~76 total connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Bound stalled database connections/operations (seconds).
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30

# ---- Security --------------------------------------------------------------
# Generate a strong random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
JWT_EXPIRE_HOURS=12

# QA admin login. CHANGE these from the local demo values before going public.
QA_ADMIN_USER=qa_admin
QA_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
QA_ADMIN_NAME=QA Administrator

# ---- CORS ------------------------------------------------------------------
# Your deployed frontend origin(s), comma-separated. NO trailing slash.
# e.g. https://example.invalid
CORS_ORIGINS=https://your-site.pages.dev
