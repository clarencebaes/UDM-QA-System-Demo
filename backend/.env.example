# Copy this file to .env and change values if your XAMPP MySQL is not the default.
# Default XAMPP: user root, empty password, port 3306.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=udm_qa_demo

# Change this before any real deployment. Local demo only.
JWT_SECRET=udm-qa-local-dev-change-me
JWT_EXPIRE_HOURS=12

# Frontend origin (Vite default)
CORS_ORIGINS=http://localhost:5173
